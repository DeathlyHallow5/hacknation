# Źródło API dla /api/v1/* (czytane w czasie działania, bez przebudowy):
#   mock   — wbudowany mock (domyślnie)
#   proxy  — wszystko do backendu Rust pod ASI_API_URL
#   hybrid — najpierw Rust; brakujące endpointy (501 / 404 bez JSON) obsługuje mock
ASI_API_MODE=mock

# Adres backendu Rust (axum), np. lokalnie lub w Docker Compose: http://api:8080
ASI_API_URL=http://localhost:8080

# Nazwa ciasteczka sesji, po którym proxy.ts wpuszcza na strony
ASI_SESSION_COOKIE=asi_session

# Sztuczne opóźnienie odpowiedzi mocka w ms (0 = bez opóźnienia)
ASI_MOCK_LATENCY_MS=140
