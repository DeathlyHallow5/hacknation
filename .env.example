# Copy to .env and fill in. Never commit .env.

# Encryption-at-rest key for sensitive scan fields (pgp_sym_encrypt). Generate with:
#   openssl rand -base64 32
ASI_DATA_KEY=

POSTGRES_PASSWORD=asi-dev-password

# First admin, created at startup while no active admin exists (12..=256 characters).
# The scripts in scripts/ sign in with these too. Generate with: openssl rand -base64 18
ASI_ADMIN_USER=admin
ASI_ADMIN_PASSWORD=
# Session lifetime in hours; set ASI_COOKIE_SECURE=true when served over HTTPS.
ASI_SESSION_TTL_HOURS=12
ASI_COOKIE_SECURE=false

ASI_WEB_PORT=3000
ASI_API_PORT=8000
ASI_MAX_CONCURRENCY=256

# Scan scope (the core refuses anything else, deny by default). IPv4 CIDRs and numeric ports,
# comma-separated; top-N port presets are refused — the built-in profile "Laboratorium" scans
# exactly ASI_ALLOWED_PORTS. Defaults in compose.yaml: the local lab and 8 common ports.
# ASI_ALLOWED_CIDRS=172.30.0.0/24
# ASI_ALLOWED_PORTS=22,80,443,3306,5432,6379,8080,8443
# ASI_EXCLUDED_CIDRS=
# DNS names that may be targets, with their subdomains (each must resolve into ASI_ALLOWED_CIDRS);
# default: asi.test (the lab: www/intranet/blog/admin.staging.asi.test).
# ASI_ALLOWED_DOMAINS=asi.test
# DNS servers for the port scanner; default: the container's own (/etc/resolv.conf).
# ASI_DNS_RESOLVERS=
# Packets/s shared by all scan slots of this instance, and the number of slots.
# ASI_GLOBAL_PPS=1000
# ASI_MAX_RUNS=1
# Emergency stop: create deploy/control/STOP to kill running scanners and refuse new ones.

# Local DefectDojo (compose.yaml, docs/DEFECTDOJO.md), required: random strings, e.g. openssl rand -hex 16
# (the README's quick start fills them in). ASI connects to it by itself on the first start.
DD_SECRET_KEY=
DD_CREDENTIAL_AES_256_KEY=
DD_DATABASE_PASSWORD=
DD_ADMIN_PASSWORD=

# Another DefectDojo instead of the local one (otherwise set in Administracja → Integracje)
DEFECTDOJO_URL=
DEFECTDOJO_TOKEN=

# TestLab (docker compose --profile testlab up -d): extra latency of the proxied WordPress, ms
# TL_LATENCY_MS=0
