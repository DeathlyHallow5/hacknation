# Copy to .env and fill in. Never commit .env.

# Encryption-at-rest key for sensitive scan fields (pgp_sym_encrypt). Generate with:
#   openssl rand -base64 32
ASI_DATA_KEY=

POSTGRES_PASSWORD=asi-dev-password

# First admin, created at startup while no active admin exists (12..=256 characters).
# The scripts in scripts/ sign in with these too. Generate with: openssl rand -base64 18
ASI_ADMIN_USER=admin
ASI_ADMIN_PASSWORD=
# Session lifetime in hours; set ASI_COOKIE_SECURE=true when served over HTTPS.
ASI_SESSION_TTL_HOURS=12
ASI_COOKIE_SECURE=false

ASI_WEB_PORT=3000
ASI_API_PORT=8000
ASI_MAX_CONCURRENCY=256

# Optional DefectDojo integration (PROJECT.md §11.2)
DEFECTDOJO_URL=
DEFECTDOJO_TOKEN=
